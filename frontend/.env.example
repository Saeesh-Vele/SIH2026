# Where the FastAPI controller is listening. Defaults to this if unset.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Firebase web app config (Firebase console → Project settings → Your apps).
# These are public identifiers, not secrets; access is controlled by the
# backend verifying ID tokens. Enable Google, Email/Password and Anonymous
# under Authentication → Sign-in method, and add the hosted domain under
# Authentication → Settings → Authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
