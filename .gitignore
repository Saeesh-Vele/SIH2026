# Node
node_modules/
.next/
frontend/node_modules/

# Python
__pycache__/
*.pyc
venv/
.venv/
backend/venv/

# Env files
.env
.env.local

# Large model files. Pretrained encoders are downloaded, not versioned:
# backend/weights/fusion/ holds ~350 MB of SSL4EO-S12 ViT-B/16 checkpoints.
backend/weights/
*.safetensors
*.bin
*.pth

# ...with one exception. backend/checkpoints/ holds LoRA adapters we trained
# ourselves — tens of MB, and the code is meaningless without the weights it
# was tuned against, so they are versioned alongside it. No blanket
# `checkpoints/` rule here on purpose: an excluded directory cannot be
# re-included from inside, so the rule has to stay off the directory itself.
!backend/checkpoints/**/*.safetensors
!backend/checkpoints/**/*.bin

# Archives the adapters were unpacked from — the unpacked copy is what ships.
*.zip

# OS
.DS_Store

# Firebase service-account keys are secrets. Never commit one.
*firebase-adminsdk*.json
*service-account*.json
*serviceAccount*.json

# TypeScript incremental build cache
*.tsbuildinfo
