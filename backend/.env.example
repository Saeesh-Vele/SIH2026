SATQUERY_MONGO_URI=mongodb://localhost:27017
SATQUERY_MONGO_DB=satquery
SATQUERY_CORS_ORIGINS=["http://localhost:3000"]

# Point at a different registry file — handy for running a small local model
# without editing model_config.yaml.
# SATQUERY_MODEL_CONFIG_PATH=./model_config.local.yaml

# Intent classification. Without a key the controller falls back to keyword
# classification and records that it did so in the trace.
# SATQUERY_OPENROUTER_API_KEY=sk-or-...
# SATQUERY_OPENROUTER_MODEL=deepseek/deepseek-chat     # or google/gemini-2.0-flash-001
